"use client";
import { FormBuilder, type FormBuilderField } from "@/components/form/form-builder";
import { update{{pascalCase name}} } from "@/lib/actions/{{kebabCase name}}/api";
import { {{pascalCase name}} } from "@/lib/actions/{{kebabCase name}}/types";
import { Alive } from "@/lib/api/collector";
import { useTranslation } from "@/hooks/use-translation";
import { useScreenItem } from "@/components/agent/screen-registry";
import { useQueryClient } from "@tanstack/react-query";
import { useMemo } from "react";
import { z } from 'zod';

interface {{pascalCase name}}EditProps {
    {{lowerCase name}}: {{pascalCase name}} | null;
    onCancel?: () => void;
    onSuccess?: () => void;
}

export function {{pascalCase name}}Edit({ {{lowerCase name}}, onCancel, onSuccess }: {{pascalCase name}}EditProps) {
    const { t } = useTranslation('{{camelCase name}}');
    const queryClient = useQueryClient();
    // Diz ao agente qual registro está aberto na tela (ver screen-registry).
    useScreenItem('record', '{{camelCase name}}s', {{lowerCase name}}?.id);

    const update{{pascalCase name}}Schema = useMemo(() =>
        z.object({
            name: z.string().min(1, t('nameRequired')),
            description: z.string().optional(),
            isActive: z.boolean().optional(),
        }),
    [t]);

    const {{lowerCase name}}Fields = useMemo<FormBuilderField[]>(() => [
        { name: 'name', label: t('name'), placeholder: t('namePlaceholder') },
        { name: 'description', label: t('description'), type: 'textarea', placeholder: t('descriptionPlaceholder') },
        { name: 'isActive', label: t('isActive'), type: 'checkbox' },
    ], [t]);

    if (!{{lowerCase name}}) return null;

    return (
        <FormBuilder
            key={ {{lowerCase name}}.id}
            schema={update{{pascalCase name}}Schema}
            fields={ {{lowerCase name}}Fields}
            mode="edit"
            values=\{{
                name: {{lowerCase name}}.name,
                description: {{lowerCase name}}.description ?? undefined,
                isActive: {{lowerCase name}}.isActive,
            }}
            onCancel={onCancel}
            onSubmit={async (data) => {
                const result = await Alive(() => update{{pascalCase name}}({{lowerCase name}}.id, data))();
                return result;
            }}
            onSuccess={() => {
                queryClient.invalidateQueries({ queryKey: ['{{camelCase name}}s'] });
                onSuccess?.();
            }}
            onError={(error) => {
                console.error('Error updating {{lowerCase name}}:', error);
            }}
            submitLabel={t('save')}
            cancelLabel={t('cancel')}
        />
    )
}
