import { Injectable } from '@nestjs/common';
import { PrismaService } from '../../../prisma/prisma.service';
import { LoggingService } from '../../logging/logging.service';
import { LogActions } from 'src/domain/logging/log-actions';
import type { {{pascalCase name}} } from 'src/domain/{{kebabCase name}}/{{kebabCase name}}.entity';
import type { Update{{pascalCase name}}Dto } from '../dto/update-{{kebabCase name}}.dto';
import { FindOne{{pascalCase name}}UseCase } from './find-one.use-case';

@Injectable()
export class Update{{pascalCase name}}UseCase {
  constructor(
    private readonly prisma: PrismaService,
    private readonly loggingService: LoggingService,
    private readonly findOne: FindOne{{pascalCase name}}UseCase,
  ) {}

  async execute(
    id: string,
    dto: Update{{pascalCase name}}Dto,
    performedById: string,
  ): Promise<{{pascalCase name}}> {
    // Prisma num id inexistente estoura P2025 (500, não 404).
    await this.findOne.execute(id);

    const updated = await this.prisma.{{camelCase name}}.update({
      where: { id },
      data: { ...dto },
    });

    await this.loggingService.create(
      {
        module: '{{constantCase name}}',
        action: LogActions.UPDATE,
        message: `{{pascalCase name}} atualizado: ${updated.name}`,
        metadata: { {{camelCase name}}Id: id },
      },
      performedById,
    );

    return updated;
  }
}
