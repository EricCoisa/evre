import { createZodDto } from 'nestjs-zod';
import { z } from 'zod';

export const Update{{pascalCase name}}Schema = z
  .object({
    name: z.string().min(1).optional().describe('Name of the {{lowerCase name}}'),
    description: z.string().optional().describe('Description of the {{lowerCase name}}'),
    isActive: z.boolean().optional().describe('Active status'),
  })
  .strict();

export class Update{{pascalCase name}}Dto extends createZodDto(Update{{pascalCase name}}Schema) {}
