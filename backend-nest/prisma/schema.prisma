// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  DRAFT
  INVITED
  ACTIVE
}

enum ProposalStatus {
  DRAFT
  SENT
  APPROVED
}

enum ContractStatus {
  DRAFT
  SENT
  ACCEPTED
  ARCHIVED
}

enum ProjectStatus {
  PROPOSAL
  REQUIREMENTS
  DEVELOPMENT
  DONE
}

enum StageStatus {
  TODO
  DOING
  DONE
}

enum ActivityStatus {
  TODO
  DOING
  DONE
}

enum ApprovalStatus {
  APPROVED
  APPROVED_WITH_REMARKS
  REJECTED
}

enum ProjectHistoryType {
  STATUS_CHANGE
  COMMENT
  APPROVAL
  APPROVAL_REQUESTED
  STAGE_CREATED
  STAGE_UPDATED
  STAGE_DELETED
  STAGE_REORDERED
  ACTIVITY_CREATED
  ACTIVITY_UPDATED
  ACTIVITY_DELETED
  ACTIVITY_MOVED
}

enum CommentEntityType {
  PROJECT
  STAGE
  ACTIVITY
}

enum ApprovalEntityType {
  STAGE
}

enum ApprovalRequestStatus {
  PENDING
  ANSWERED
  CANCELED
}

enum LogModule {
  USER
  AUTH
  SYSTEM
  HEALTH
  USER_ROUTE_ACCESS
  SYSTEM_CONFIGURATION
  ROUTE
  ROLE_ROUTE_ACCESS
  USER_CONFIGURATION
  USER_CONFIGURATION_DEFINITION
  COMPANY
  PROPOSAL
  CONTRACT_DOCUMENT
  PROJECT
  STAGE
  ACTIVITY
  COMMENT
  APPROVAL
  PROJECT_HISTORY
  APPROVAL_REQUEST
}

// Example model - customize as needed
model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  name                String?
  image               Bytes?               // Campo para armazenar foto do usuário (máx 40MB)
  role                UserRole             @default(USER)
  status              UserStatus           @default(ACTIVE)
  companyId           String?              // Relação opcional com Company
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  systemLogs          SystemLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  userRouteAccesses   UserRouteAccess[]
  grantedRouteAccesses UserRouteAccess[]   @relation("GrantedBy")
  userConfigurations  UserConfiguration[]
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  comments            Comment[]
  approvals           Approval[]
  approvalRequests    ApprovalRequest[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SystemLog {
  id            String    @id @default(uuid())
  module        LogModule
  action        String
  message       String
  metadata      String?   // SQLite não suporta Json nativo, usa String
  performedById String?
  createdAt     DateTime  @default(now())
  performedBy   User?     @relation(fields: [performedById], references: [id])

  @@index([module, createdAt])
  @@index([performedById])
  @@map("system_log")
}

model Route {
  id                String            @id @default(uuid())
  path              String            @unique
  labelKey          String
  icon              String?           // Nome do ícone lucide-react
  parentId          String?
  ordem             Int               @default(0)
  isHome            Boolean           @default(false)
  isClientHome      Boolean           @default(false)
  isActive          Boolean           @default(true)
  showSideBar       Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  parent            Route?            @relation("RouteHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Route[]           @relation("RouteHierarchy")
  userRouteAccesses UserRouteAccess[]
  roleRouteAccesses RoleRouteAccess[]

  @@index([parentId])
  @@index([isActive])
  @@index([ordem])
  @@index([isHome])
  @@map("routes")
}

model UserRouteAccess {
  id          String   @id @default(uuid())
  userId      String
  routeId     String
  grantedBy   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  grantedByUser User?  @relation("GrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, routeId])
  @@index([userId])
  @@index([routeId])
  @@index([grantedBy])
  @@map("user_route_accesses")
}

model RoleRouteAccess {
  roleId   UserRole
  routeId  String
  
  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([roleId, routeId])
  @@index([roleId])
  @@index([routeId])
  @@map("role_route_accesses")
}

model SystemConfiguration {
  id        String   @id @default(uuid())
  labelKey  String   @unique
  valueType String
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_configurations")
}

model UserConfigurationDefinition {
  id                   String              @id @default(uuid())
  labelKey             String              @unique
  valueType            String
  defaultValue         String?
  isRequired           Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  
  userConfigurations   UserConfiguration[]

  @@map("user_configuration_definitions")
}

model UserConfiguration {
  id            String   @id @default(uuid())
  userId        String
  definitionId  String
  value         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition    UserConfigurationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([userId, definitionId])
  @@index([userId])
  @@index([definitionId])
  @@map("user_configurations")
}

model Company {
  id        String        @id @default(uuid())
  name      String
  status    CompanyStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  users     User[]
  proposals Proposal[]
  projects  Project[]
    clientLogs          ClientLog[] // Adicionando relação inversa com ClientLog

  @@map("companies")
}

model Proposal {
  id                    String         @id @default(uuid())
  companyId             String
  projectId             String?        // Vínculo opcional com Project
  name                  String         @default("")
  status                ProposalStatus @default(DRAFT)
  contentSchemaVersion  String         @default("v1")
  content               String         // JSON armazenado como string
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  company               Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project               Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contracts             ContractDocument[] // Uma proposta pode ser referenciada por vários contratos

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("proposals")
}

model Project {
  id          String        @id @default(uuid())
  companyId   String
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PROPOSAL)
  token       String?       // Token para autenticação do webhook
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages      Stage[]
  histories   ProjectHistory[]
  proposals   Proposal[]       // Um projeto pode ter várias propostas
  contracts   ContractDocument[] // Um projeto pode ter vários contratos
  comments    Comment[]
  approvals   Approval[]
  approvalRequests ApprovalRequest[]
  clientLogs  ClientLog[]      // Adicionando relação inversa com ClientLog

  @@index([companyId])
  @@index([status])
  @@map("projects")
}

model Stage {
  id        String      @id @default(uuid())
  projectId String
  name      String
  order     Int
  status    StageStatus @default(TODO)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities Activity[]
  approvalRequests ApprovalRequest[]

  @@index([projectId])
  @@index([order])
  @@index([status])
  @@map("stages")
}

model Activity {
  id          String         @id @default(uuid())
  stageId     String
  title       String
  description String?        @db.Text
  status      ActivityStatus @default(TODO)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  stage       Stage          @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
  @@index([status])
  @@index([order])
  @@map("activities")
}

model Comment {
  id         String            @id @default(uuid())
  projectId  String            // Contexto raiz obrigatório
  entityType CommentEntityType // PROJECT, STAGE, ou ACTIVITY
  entityId   String            // ID da entidade comentada
  userId     String
  content    String            @db.Text
  createdAt  DateTime          @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("comments")
}

model Approval {
  id                String              @id @default(uuid())
  approvalRequestId String              @unique // Vínculo obrigatório 1:1
  projectId         String              // Contexto raiz obrigatório
  entityType        ApprovalEntityType  // STAGE (por enquanto)
  entityId          String              // ID da entidade aprovada
  userId            String
  status            ApprovalStatus
  comment           String?             @db.Text
  createdAt         DateTime            @default(now())

  approvalRequest   ApprovalRequest     @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("approvals")
}

model ProjectHistory {
  id        String             @id @default(uuid())
  projectId String
  type      ProjectHistoryType
  payload   String             // JSON armazenado como string
  createdAt DateTime           @default(now())

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@map("project_histories")
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  telefone  String
  text      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

model ClientLog {
  id           String   @id @default(uuid())
  companyId    String
  projectId    String
  environment  String
  metadata     String?
  createdAt    DateTime @default(now())

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([environment])
  @@map("client_logs")
}

model ContractDocument {
  id                    String         @id @default(uuid())
  projectId             String
  proposalId            String?        // Referência opcional a uma proposta
  name                  String
  version               Int            @default(1) // Versionamento explícito
  status                ContractStatus @default(DRAFT)
  contentSchemaVersion  String         @default("v1")
  content               String         @db.Text // JSON semântico armazenado como string
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposal              Proposal?      @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([proposalId])
  @@index([status])
  @@map("contract_documents")
}


model ApprovalRequest {
  id            String                 @id @default(uuid())
  projectId     String
  stageId       String
  requestedById String
  status        ApprovalRequestStatus  @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage         Stage                  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  requestedBy   User                   @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  approval      Approval?              // Relação 1:1 opcional (pode não ter resposta ainda)

  @@unique([stageId, status], map: "unique_pending_per_stage")
  @@index([projectId])
  @@index([stageId])
  @@index([requestedById])
  @@index([status])
  @@map("approval_requests")
}