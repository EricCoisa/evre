enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED

  @@schema("public")
}

/// Projeto de desenvolvimento vinculado a uma empresa. Acompanhado pelo cliente via Membership.
model Project {
  id          String        @id @default(uuid())
  companyId   String
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  milestones   ProjectMilestone[]
  memberships  Membership[]
  comments     ProjectComment[]
  infoRequests ProjectInfoRequest[]

  @@index([companyId])
  @@index([status])
  @@map("projects")
  @@schema("public")
}

/// Coluna do board (milestone). `position` define a ordem visual.
model ProjectMilestone {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String?  @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     ProjectTask[]
  approvals MilestoneApproval[]

  @@index([projectId])
  @@map("project_milestones")
  @@schema("public")
}

enum ProjectTaskStatus {
  WAITING
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED

  @@schema("public")
}

/// Card dentro de uma milestone. `position` define a ordem dentro da coluna.
model ProjectTask {
  id            String            @id @default(uuid())
  milestoneId   String
  title         String
  description   String?           @db.Text
  status        ProjectTaskStatus @default(WAITING)
  blockedReason String?           @db.Text
  assigneeId    String?
  position      Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  milestone ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignee  User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([status])
  @@index([assigneeId])
  @@map("project_tasks")
  @@schema("public")
}

// ─── Comentários ─────────────────────────────────────────────

enum ProjectCommentEntityType {
  PROJECT
  MILESTONE
  TASK

  @@schema("public")
}

/// Comentário em qualquer entidade do projeto. `projectId` garante cascade; `entityType`+`entityId` localizam o alvo.
model ProjectComment {
  id         String                    @id @default(uuid())
  projectId  String
  entityType ProjectCommentEntityType
  entityId   String
  authorId   String
  content    String                    @db.Text
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, entityType, entityId])
  @@map("project_comments")
  @@schema("public")
}

// ─── Aprovação de milestone ──────────────────────────────────

enum MilestoneApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("public")
}

/// Solicitação de aprovação de uma milestone. O admin solicita; o cliente (ou o próprio admin) responde.
model MilestoneApproval {
  id             String                  @id @default(uuid())
  milestoneId    String
  status         MilestoneApprovalStatus @default(PENDING)
  requestedById  String
  respondedById  String?
  requestNote    String?                 @db.Text
  responseNote   String?                 @db.Text
  requestedAt    DateTime                @default(now())
  respondedAt    DateTime?

  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  requestedBy User             @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  respondedBy User?            @relation("ApprovalRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@map("milestone_approvals")
  @@schema("public")
}

// ─── Solicitação de informação sensível ──────────────────────

enum ProjectInfoRequestStatus {
  PENDING
  ANSWERED
  EXPIRED
  CANCELLED

  @@schema("public")
}

/// Pedido de informação sensível ao cliente. Resposta criptografada via CryptoService (AES-256-GCM).
model ProjectInfoRequest {
  id             String                   @id @default(uuid())
  projectId      String
  label          String
  description    String?                  @db.Text
  status         ProjectInfoRequestStatus @default(PENDING)
  requestedById  String
  answeredById   String?
  encryptedValue String?                  @db.Text
  answeredAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("InfoRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  answeredBy  User?   @relation("InfoAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_info_requests")
  @@schema("public")
}
