/// Vínculo usuário × escopo (empresa e/ou projeto) que autoriza leitura de recurso — ver resource-access.service.ts.
model Membership {
  id                String   @id @default(uuid())
  userId            String
  companyId         String?
  projectId         String?
  canSeeCommercials Boolean  @default(false)
  canComment        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, projectId])
  @@index([userId])
  @@index([companyId])
  @@index([projectId])
  @@map("memberships")
  @@schema("public")
}
