enum MembershipScopeRole {
  OWNER
  COLLABORATOR
  VIEWER

  @@schema("public")
}

/// Vínculo usuário × escopo (empresa e/ou projeto) que autoriza leitura de recurso — ver resource-access.service.ts.
model Membership {
  id        String              @id @default(uuid())
  userId    String
  companyId String?
  // ponytail: sem FK até projectId existir como model (F2-02)
  projectId String?
  scopeRole MembershipScopeRole @default(COLLABORATOR)
  canSeeCommercials Boolean @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, projectId])
  @@index([userId])
  @@index([companyId])
  @@index([projectId])
  @@map("memberships")
  @@schema("public")
}
