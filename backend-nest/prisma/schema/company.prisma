/// Empresa cliente/prospect do EVRE. Nasce só com nome — campo de proposta cria inline a partir de texto livre.
model Company {
  id         String    @id @default(uuid())
  name       String
  tradeName  String?
  taxId      String?
  site       String?
  segment    String?
  notes      String?   @db.Text
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships Membership[]
  contacts    Contact[]
  proposals   Proposal[]

  @@index([name])
  @@index([archivedAt])
  @@map("companies")
  @@schema("public")
}

/// Pessoa de contato de uma empresa. Sem tela própria — vive como aba da empresa.
model Contact {
  id              String    @id @default(uuid())
  companyId       String
  name            String
  role            String?
  email           String?
  phone           String?
  isPrimary       Boolean   @default(false)
  isDecisionMaker Boolean   @default(false)
  notes           String?   @db.Text
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("contacts")
  @@schema("public")
}
