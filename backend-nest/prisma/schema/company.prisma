/// Empresa cliente/prospect do EVRE. Nasce só com nome — campo de proposta cria inline a partir de texto livre.
model Company {
  id         String    @id @default(uuid())
  name       String
  tradeName  String?
  taxId      String?
  site       String?
  segment    String?
  notes      String?   @db.Text
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships Membership[]
  contacts    CompanyContact[]
  proposals   Proposal[]

  @@index([name])
  @@index([archivedAt])
  @@map("companies")
  @@schema("public")
}

/// Vínculo entre um MessagingContact e uma empresa. Guarda só metadata da relação (cargo, flags).
/// Identidade (nome, telefone) fica no MessagingContact.
model CompanyContact {
  id                 String    @id @default(uuid())
  companyId          String
  messagingContactId String
  role               String?
  email              String?
  isPrimary          Boolean   @default(false)
  isDecisionMaker    Boolean   @default(false)
  notes              String?   @db.Text
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messagingContact MessagingContact @relation(fields: [messagingContactId], references: [id], onDelete: Restrict)

  @@unique([companyId, messagingContactId])
  @@index([companyId])
  @@index([messagingContactId])
  @@map("company_contacts")
  @@schema("public")
}
