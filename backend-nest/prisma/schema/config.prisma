model SystemConfiguration {
  id        String          @id @default(uuid())
  labelKey  String          @unique
  valueType ConfigValueType
  options   String[]        @default([])
  value     String
  updatedAt DateTime        @updatedAt
  secret    Boolean         @default(false)
  blocked   Boolean         @default(false)

  @@map("system_configurations")
  @@schema("public")
}

model UserConfigurationDefinition {
  id           String          @id @default(uuid())
  labelKey     String          @unique
  valueType    ConfigValueType
  options      String[]        @default([])
  defaultValue String?
  isRequired   Boolean         @default(false)
  secret       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  userConfigurations UserConfiguration[]

  @@map("user_configuration_definitions")
  @@schema("public")
}

model UserConfiguration {
  id           String   @id @default(uuid())
  userId       String
  definitionId String
  value        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition UserConfigurationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([userId, definitionId])
  @@index([userId])
  @@index([definitionId])
  @@map("user_configurations")
  @@schema("public")
}
