{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "watchAssets": true,
    "assets": [
      {
        "include": "i18n/**/*",
        "outDir": "dist/src"
      }
      ,
      {
        "include": "modules/email/template/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}
