# Application
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

APP_NAME=template

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/template_db?schema=public&connection_limit=10&pool_timeout=20"

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM for system config secrets — separate from JWT signing key)
# On new installs: generate a random 32+ char string.
# On existing installs: set to the old JWT_SECRET value first, then rotate.
CRYPTO_SECRET=your-crypto-secret-change-in-production

# AI Agent → CMS bridge (backend calls frontend's Payload Local API routes via NEXTAUTH_URL;
# valor tem que ser IGUAL ao AGENT_CMS_SECRET de frontend-next/.env.local — não é a mesma
# coisa que PAYLOAD_CMS_PASSWORD, nunca reaproveitar)
AGENT_CMS_SECRET=REPLACE_WITH_AGENT_CMS_SECRET

# Seed (senha padrão para usuário admin no seed)
SEED_USER_PASSWORD=admin123

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# S3 / MinIO object storage (ENV fallback — configurable via /settings → SYSTEM_STORAGE_*)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=app-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:8333/app-uploads
S3_REGION=us-east-1

# LOCAL storage provider (fallback ENV — configured via /settings)
# STORAGE_LOCAL_DIR=./uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:3000

# AI Agent (configurado via /settings → SYSTEM_AI_* — valores são seeds no banco, não env vars)
# Provider: ANTHROPIC | OPENAI | OPENAI_COMPATIBLE
# SYSTEM_AI_PROVIDER=ANTHROPIC
# SYSTEM_AI_ANTHROPIC_API_KEY=sk-ant-placeholder
# SYSTEM_AI_ANTHROPIC_MODEL=claude-sonnet-4-6
# SYSTEM_AI_OPENAI_API_KEY=sk-placeholder
# SYSTEM_AI_OPENAI_MODEL=gpt-4o
# SYSTEM_AI_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# SYSTEM_AI_OPENAI_COMPATIBLE_API_KEY=
# SYSTEM_AI_OPENAI_COMPATIBLE_MODEL=llama3
# SYSTEM_AI_SYSTEM_PROMPT=
# SYSTEM_AGENT_OWN_KEY=false

# MCP remote connector (Claude Desktop, ChatGPT) — ver docs/backend/mcp.md
# Nao tem variavel propria e nao precisa ajuste para trocar de dominio: o front expoe
# /mcp, /oauth/* e /.well-known/*, faz proxy para o backend e informa a origem publica
# por request. A URL a colar no cliente e <dominio-do-front>/mcp. NEXTAUTH_URL entra
# apenas como fallback. Claude Desktop e ChatGPT recusam http:// — em desenvolvimento
# exponha o front por um tunnel https.

# Observability (opt-in — leave empty to disable)
# Leaving it empty falls back to the SYSTEM_SENTRY_DSN key in /settings. This env
# wins when both are set: it is the only one loaded before the app imports, so it
# is what enables auto-instrumentation (HTTP, Prisma).
# PDF (Gotenberg — geração server-side de PDF)
# No compose local, aponta pro serviço gotenberg. Em produção (Coolify), aponta pro hostname interno do Template Infra.
PDF_SERVICE_URL=http://gotenberg:3000

SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # OpenTelemetry collector

# Stripe (opt-in — leave empty for FREE-only mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
