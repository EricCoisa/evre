{
  "extends": "./tsconfig.json",
  // `nest build` (tsconfig.build.json) exclui `**/*spec.ts`, e o vitest não faz
  // typecheck — sem este arquivo, erro de tipo em spec fica invisível até
  // alguém rodar tsc na mão. `npm run typecheck` cobre esse buraco.
  //
  // Os dois arquivos abaixo carregam um erro de tipo PRÉ-EXISTENTE, sem relação com
  // o schema (Organization/Membership/User.role, reconciliado em F0-05): cast direto
  // `as string[]` sobre `set-cookie` (TS2352) e import com caminho relativo quebrado
  // (TS2307). Remover a exclusão de cada um assim que for corrigido.
  "exclude": [
    "node_modules",
    "dist",
    "test/auth.e2e-spec.ts",
    "test/messaging-webhook.e2e-spec.ts"
  ]
}
