  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "prisma generate && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:cov": "vitest run --config ./vitest.config.ts --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:serial": "vitest run --config ./vitest.config.e2e.ts --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "migrate:deploy": "prisma migrate deploy",
    "deploy": "prisma generate && prisma migrate deploy",
    "plop": "plop",
    "openapi:export": "ts-node --project tsconfig.scripts.json --transpile-only -r tsconfig-paths/register scripts/export-openapi.ts"
  },
