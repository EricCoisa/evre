{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend (Debug Mode)",
            "type": "shell",
            "command": "npm run start:debug",
            "options": {
                "cwd": "${workspaceFolder}/backend-nest"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting compilation in watch mode",
                    "endsPattern": "Debugger listening on|Compiled successfully"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "backend"
            }
        },
        {
            "label": "Start Frontend (Dev Mode)",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend-next"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "▲ Next.js|starting the development server",
                    "endsPattern": "Local:|Ready in|compiled successfully"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "frontend"
            }
        },
        {
            "label": "Start Full Stack",
            "dependsOn": [
                "Start Backend (Debug Mode)",
                "Start Frontend (Dev Mode)"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        }
        ,
        {
            "label": "Start Docker Compose (Debug)",
            "type": "shell",
            "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml up --build -d",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Stop Docker Compose (Debug)",
            "type": "shell",
            "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml down",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}

