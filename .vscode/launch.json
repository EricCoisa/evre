{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Backend (Local)",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/backend-nest/dist/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/backend-nest/**",
        "!**/node_modules/**"
      ],
      "preLaunchTask": "Start Backend (Debug Mode)"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Frontend (Local)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend-next",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "preLaunchTask": "Start Frontend (Dev Mode)"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Backend (Docker)",
      "address": "localhost",
      "port": 9229,
      "localRoot": "${workspaceFolder}/backend-nest",
      "remoteRoot": "/app",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/backend-nest/dist/**/*.js"],
      "preLaunchTask": "Start Docker Compose (Debug)"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Frontend (Docker)",
      "address": "localhost",
      "port": 9228,
      "localRoot": "${workspaceFolder}/frontend-next",
      "remoteRoot": "/app",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Local)",
      "configurations": [
        "Backend (Local)",
        "Frontend (Local)"
      ]
    },
    {
      "name": "Full Stack (Docker)",
      "configurations": [
        "Backend (Docker)",
        "Frontend (Docker)"
      ]
    }
  ]
}